PORT=5000
NODE_ENV=production

MONGO_URI=mongodb+srv://<username>:<password>@<cluster>/<database>?retryWrites=true&w=majority
JWT_SECRET=replace-with-a-long-random-secret
OPENAI_API_KEY=sk-your-openai-key

PAYFAST_MERCHANT_ID=your-payfast-merchant-id
PAYFAST_MERCHANT_KEY=your-payfast-merchant-key
PAYFAST_PASSPHRASE=your-payfast-passphrase
PAYFAST_MODE=live
PAYFAST_SANDBOX=false

# If the frontend and backend are on the same domain, use that same public URL.
PUBLIC_URL=https://cvforu.co.za
APP_URL=https://cvforu.co.za
FRONTEND_URL=https://cvforu.co.za
ALLOWED_ORIGINS=https://cvforu.co.za,https://www.cvforu.co.za

# Password reset email settings
# Preferred option: SMTP (works with Gmail app passwords)
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_SECURE=false
EMAIL_USER=your-email@gmail.com
EMAIL_PASS=your-app-password
EMAIL_FROM=CV for U <your-email@gmail.com>
EMAIL_REPLY_TO=support@cvforu.co.za

# Optional fallback: Resend
RESEND_API_KEY=re_your_resend_api_key
RESEND_FROM=CV for U <noreply@cvforu.co.za>

EXPOSE_PASSWORD_RESET_LINKS=false
